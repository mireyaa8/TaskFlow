@model TaskFlow.Services.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted mb-0">Overview of your projects, boards, and assigned tasks.</p>
    </div>

    <a asp-controller="Projects" asp-action="Create" class="btn btn-primary">
        Create Project
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Projects</h5>
                <p class="display-5 mb-0">@Model.ProjectsCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">Boards</h5>
                <p class="display-5 mb-0">@Model.BoardsCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-dark h-100">
            <div class="card-body">
                <h5 class="card-title">Assigned Tasks</h5>
                <p class="display-5 mb-0">@Model.MyTasksCount</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-secondary h-100">
            <div class="card-body">
                <h5 class="card-title">To Do</h5>
                <p class="display-6 mb-0">@Model.ToDoTasksCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-info h-100">
            <div class="card-body">
                <h5 class="card-title">In Progress</h5>
                <p class="display-6 mb-0">@Model.InProgressTasksCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-success h-100">
            <div class="card-body">
                <h5 class="card-title">Done</h5>
                <p class="display-6 mb-0">@Model.DoneTasksCount</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        Recent Assigned Tasks
    </div>

    <div class="card-body">
        @if (!Model.RecentTasks.Any())
        {
            <div class="alert alert-info mb-0">
                You do not have any assigned tasks yet.
            </div>
        }
        else
        {
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Due Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.RecentTasks)
                    {
                        <tr>
                            <td>@task.Title</td>
                            <td>
                                <span class="badge bg-info">@task.Status</span>
                            </td>
                            <td>@task.Priority</td>
                            <td>
                                @(task.DueDate.HasValue ? task.DueDate.Value.ToString("dd MMM yyyy") : "No due date")
                            </td>
                            <td class="text-end">
                                <a asp-controller="Tasks"
                                   asp-action="Details"
                                   asp-route-id="@task.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Open
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>