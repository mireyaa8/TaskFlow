@model TaskFlow.Services.Models.LabelInputModel

@{
    ViewData["Title"] = "Delete Label";
}

<h1>Delete Label</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this label?
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@Model.Name</h5>
        <span class="badge bg-@Model.Color">@Model.Name</span>
    </div>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@ViewBag.LabelId" method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="All" class="btn btn-secondary">Cancel</a>
</form>