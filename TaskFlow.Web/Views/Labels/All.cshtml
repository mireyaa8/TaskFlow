@model IEnumerable<TaskFlow.Services.Models.LabelViewModel>

@{
    ViewData["Title"] = "Labels";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Labels</h1>
    <a class="btn btn-primary" asp-action="Create">Create Label</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No labels have been created yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Preview</th>
                <th>Color</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var label in Model)
            {
                <tr>
                    <td>@label.Name</td>
                    <td>
                        <span class="badge bg-@label.Color">@label.Name</span>
                    </td>
                    <td>@label.Color</td>
                    <td class="text-end">
                        <a asp-action="Edit"
                           asp-route-id="@label.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@label.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}