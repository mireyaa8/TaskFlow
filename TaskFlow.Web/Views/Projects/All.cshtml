@model IEnumerable<TaskFlow.Services.Models.ProjectViewModel>

@{
    ViewData["Title"] = "My Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Projects</h1>
    <a asp-action="Create" class="btn btn-primary">Create Project</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You do not have any projects yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@project.Name</h5>
                        <p class="card-text">@project.Description</p>
                        <p class="text-muted">Boards: @project.BoardsCount</p>
                        <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-primary">
                            Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}