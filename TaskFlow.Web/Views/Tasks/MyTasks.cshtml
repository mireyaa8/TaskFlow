@model IEnumerable<TaskFlow.Services.Models.TaskViewModel>

@{
    ViewData["Title"] = "Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Tasks</h1>
        <p class="text-muted mb-0">View and manage tasks from your accessible projects.</p>
    </div>

    <a asp-controller="Tasks" asp-action="Create" class="btn btn-primary">
        Create Task
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No tasks found yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Due Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Title</td>
                    <td>
                        <span class="badge bg-info">@task.Status</span>
                    </td>
                    <td>@task.Priority</td>
                    <td>
                        @(task.DueDate.HasValue ? task.DueDate.Value.ToString("dd MMM yyyy") : "No due date")
                    </td>
                    <td class="text-end">
                        <a asp-action="Details"
                           asp-route-id="@task.Id"
                           class="btn btn-sm btn-outline-primary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}